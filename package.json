{
  "name": "pi-share-slice",
  "version": "0.1.1",
  "description": "Select and share slices of Pi sessions with Pi's built-in HTML viewer",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpxl-dev/pi-share-slice.git"
  },
  "homepage": "https://github.com/gpxl-dev/pi-share-slice#readme",
  "bugs": {
    "url": "https://github.com/gpxl-dev/pi-share-slice/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "share",
    "gist"
  ],
  "files": [
    "extensions/**/*.ts",
    "src/config.ts",
    "src/gist.ts",
    "src/pi-internals.ts",
    "src/selection-state.ts",
    "src/share-selector.ts",
    "src/slice.ts",
    "src/system-context.ts",
    "src/viewer-patch.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-share-slice.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/bun": "1.4.0",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
